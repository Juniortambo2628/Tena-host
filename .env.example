APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Paystack Configuration
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

# M-Pesa Configuration
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=

# Ubiquiti UniFi captive portal (authorizes guest devices after they tap Connect)
# base URL incl. scheme/port: https://controller:8443 (classic) or https://192.168.1.1 (UniFi OS)
UNIFI_BASE_URL=
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_SITE=default
UNIFI_IS_OS=true
UNIFI_VERIFY_SSL=false
UNIFI_AUTH_MINUTES=1440
UNIFI_TIMEOUT=10

VITE_APP_NAME="${APP_NAME}"

# Guest messaging (SMS + WhatsApp). Drivers: null, africastalking, whatsapp_cloud
SMS_DRIVER=null
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=
WHATSAPP_DRIVER=null
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved Meta template with one body variable ({{1}}); required for messages outside the 24h window
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_FALLBACK_TO_SMS=true
# Webhook at /api/whatsapp/webhook (STOP replies, read receipts)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
